---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const [current] = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.status === 'active') - Number(a.data.status === 'active') ||
    b.data.year.localeCompare(a.data.year) ||
    b.data.order - a.data.order,
);

const [latest] = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const stamp = (date: Date) => date.toISOString().slice(0, 10).replace(/-/g, '.');
---

<Base title="index" description="software engineer. cloud and browser security, internal tooling.">
  <canvas class="anim" width="140" height="108" aria-hidden="true"></canvas>

  <div slot="meta">
    <p class="key">project</p>
    <p class="entry">
      <a href={`/projects/${current.id}`}>{current.data.title}</a>
      <span class="stamp">{current.data.status}</span>
    </p>

    <p class="key gap">writeup</p>
    <p class="entry">
      <a href={`/writeups/${latest.id}`}>{latest.data.title}</a>
      <span class="stamp">{stamp(latest.data.date)}</span>
    </p>
  </div>
</Base>

<script>
  const W = 140;
  const H = 108;
  const FPS = 30;
  const STILL = 1500;
  const BYTES = (W * H) / 8;

  const canvas = document.querySelector<HTMLCanvasElement>('.anim')!;
  const ctx = canvas.getContext('2d')!;
  const image = ctx.createImageData(W, H);
  const rgb = (token: string) => {
    ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue(token).trim();
    ctx.fillRect(0, 0, 1, 1);
    return ctx.getImageData(0, 0, 1, 1).data;
  };
  const [r, g, b] = rgb('--color-text');
  ctx.clearRect(0, 0, W, H);

  const res = await fetch('/badapple.dat');
  if (!res.ok || !res.body) throw new Error(`badapple fetch failed: ${res.status}`);
  const data = new Uint8Array(await new Response(res.body.pipeThrough(new DecompressionStream('gzip'))).arrayBuffer());
  const total = data.length / BYTES;

  const bits = new Uint8Array(BYTES);
  let at = -1;

  function step(to: number) {
    if (to < at) {
      bits.fill(0);
      at = -1;
    }
    for (; at < to; at++) {
      const base = (at + 1) * BYTES;
      for (let i = 0; i < BYTES; i++) bits[i] ^= data[base + i];
    }
    for (let i = 0; i < W * H; i++) {
      const on = bits[i >> 3] & (0x80 >> (i & 7));
      const o = i * 4;
      image.data[o] = r;
      image.data[o + 1] = g;
      image.data[o + 2] = b;
      image.data[o + 3] = on ? 255 : 0;
    }
    ctx.putImageData(image, 0, 0);
  }

  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    step(STILL);
  } else {
    const start = performance.now();
    let shown = -1;
    const tick = (now: number) => {
      const frame = Math.floor(((now - start) * FPS) / 1000) % total;
      if (frame !== shown) step(frame);
      shown = frame;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--spacing);
  }

  .stamp {
    color: var(--color-text-3);
  }

  .anim {
    width: 100%;
    max-width: 80ch;
    aspect-ratio: 140 / 108;
    image-rendering: pixelated;
  }
</style>
