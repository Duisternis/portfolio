---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import badApple from '../data/bad_apple.json';

const frames = badApple.frames.map((frame) => frame.content.join('\n'));
const interval = 1000 / badApple.animation.frameRate;

const [current] = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.status === 'active') - Number(a.data.status === 'active') ||
    b.data.year.localeCompare(a.data.year) ||
    b.data.order - a.data.order,
);

const [latest] = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const stamp = (date: Date) => date.toISOString().slice(0, 10).replace(/-/g, '.');
---

<Base title="index" description="software engineer. cloud and browser security, internal tooling.">
  <pre class="anim" aria-hidden="true">{frames[0]}</pre>

  <div slot="meta">
    <p class="key">project</p>
    <p class="entry">
      <a href={`/projects/${current.id}`}>{current.data.title}</a>
      <span class="stamp">{current.data.status}</span>
    </p>

    <p class="key gap">writeup</p>
    <p class="entry">
      <a href={`/writeups/${latest.id}`}>{latest.data.title}</a>
      <span class="stamp">{stamp(latest.data.date)}</span>
    </p>
  </div>
</Base>

<script is:inline define:vars={{ frames, interval }}>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const el = document.querySelector('.anim');
    let i = 0;
    setInterval(() => {
      i = (i + 1) % frames.length;
      el.textContent = frames[i];
    }, interval);
  }
</script>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--spacing);
  }

  .stamp {
    color: var(--color-text-3);
  }

  .anim {
    color: var(--color-text-2);
    line-height: 1;
    white-space: pre;
    overflow: hidden;
  }
</style>
