---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const stamp = (date: Date) => date.toISOString().slice(0, 10).replace(/-/g, '.');
const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))];
---

<Base title="blog" description="notes and writeups by varnan matela.">
  {
    posts.map((post) => (
      <Row meta={stamp(post.data.date)} title={post.data.title} href={`/blog/${post.id}`}>
        {post.data.summary}
      </Row>
    ))
  }

  <div slot="meta">
    <p class="key">posts</p>
    <p>{posts.length}</p>
    <p class="key gap">years</p>
    {years.map((year) => <p>{year}</p>)}
  </div>
</Base>

